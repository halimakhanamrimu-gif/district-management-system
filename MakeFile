CC = gcc
CFLAGS = -Wall -Wextra -std=c11
TARGET = district_management
SRCS = main.c hospital.c restaurant.c shopping_mall.c
OBJS = $(SRCS:.c=.o)

all: $(TARGET)

$(TARGET): $(OBJS)
	$(CC) $(CFLAGS) -o $@ $(OBJS)

%.o: %.c
	$(CC) $(CFLAGS) -c $< -o $@

clean:
	rm -f $(TARGET) $(OBJS)

.PHONY: all clean
